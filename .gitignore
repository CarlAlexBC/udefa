# Dependencias (hoisted por npm workspaces)
node_modules/

# Builds
dist/
build/

# Logs
logs/
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output/

# Editores / IDE
.idea/
.vscode/
*.swp
.DS_Store

# Ajustes locales de Claude Code (permisos, preferencias de cada máquina).
# .claude/launch.json sí se versiona: es la config del servidor de desarrollo
# y le sirve a cualquiera que clone el repo.
.claude/settings.local.json

# Variables de entorno (nunca al repo)
.env
.env.*
!.env.example

# Temporales
*.tmp
*.tsbuildinfo

# Libros y temarios del examen cultural.
# Son ~300 MB de PDF escaneados y además material con derechos de autor: no
# tienen por qué vivir en el repo. Los reactivos que salen de ellos sí se
# versionan, en docs/examen-cultural/.
# Cómo obtenerlos y qué ediciones son las correctas: docs/examen-cultural/README.md
examen_cultural/

# Convocatoria oficial de admisión. Es la fuente del Anexo "H" que define el
# formato del examen cultural, pero es un documento público de la SEDENA que se
# vuelve a descargar: no hay razón para cargar 3.4 MB en el repo.
LICENCIATURAS_Y_TECNICO_SUP._UNIV._*.pdf

# Paginas renderizadas de los escaneos (render.py / crop.py).
# Son intermedios de trabajo: se regeneran del PDF cuando se necesiten.
docs/examen-cultural/hoja_*.png
docs/examen-cultural/crop_*.png
