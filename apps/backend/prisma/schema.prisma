// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Plantel {
  id                Int                    @id @default(autoincrement())
  nombre            String
  descripcion       String?
  usuarios          Usuario[]
  sesionesCompletas SesionExamenCompleto[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Usuario {
  id                Int                    @id @default(autoincrement())
  nombre            String
  email             String                 @unique
  sesiones          Sesion[]
  password          String
  nivelAcceso       String                 @default("gratuito")
  emailVerificado   Boolean                @default(false)
  plantelId         Int?
  plantel           Plantel?               @relation(fields: [plantelId], references: [id])
  sesionesCompletas SesionExamenCompleto[]
  intentos          IntentoExamen[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Sesion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
}

model Examen {
  id             Int             @id @default(autoincrement())
  tipo           String
  nombre         String
  duracionMin    Int
  calificable    Boolean         @default(true)
  bloques        Bloque[]
  intentos       IntentoExamen[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Bloque {
  id            Int        @id @default(autoincrement())
  examenId      Int
  examen        Examen     @relation(fields: [examenId], references: [id])
  nombre        String
  orden         Int
  tiempoLimite  Int
  reactivos     Reactivo[]
  createdAt     DateTime   @default(now())
}

model Reactivo {
  id                Int        @id @default(autoincrement())
  bloqueId          Int
  bloque            Bloque     @relation(fields: [bloqueId], references: [id])
  enunciado         String
  tipo              String     @default("opcion_multiple")
  opciones          Json
  respuestaCorrecta String?
  explicacion       String?
  tema              String?
  polaridad         Polaridad?
  imagenUrl         String?
  respuestas        RespuestaReactivo[]
  createdAt         DateTime   @default(now())
}

enum Polaridad {
  POSITIVA
  NEGATIVA
}

enum EstadoSesion {
  EN_PROGRESO
  COMPLETADA
  ABANDONADA
}

enum EstadoIntento {
  EN_PROGRESO
  COMPLETADA
  TIEMPO_AGOTADO
  ABANDONADA
}

model SesionExamenCompleto {
  id          Int             @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario         @relation(fields: [usuarioId], references: [id])
  plantelId   Int
  plantel     Plantel         @relation(fields: [plantelId], references: [id])
  inicioAt    DateTime        @default(now())
  finAt       DateTime?
  estado      EstadoSesion    @default(EN_PROGRESO)
  intentos    IntentoExamen[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model IntentoExamen {
  id                Int                    @id @default(autoincrement())
  usuarioId         Int
  usuario           Usuario                @relation(fields: [usuarioId], references: [id])
  examenId          Int
  examen            Examen                 @relation(fields: [examenId], references: [id])
  sesionCompletoId  Int?
  sesionCompleto    SesionExamenCompleto?  @relation(fields: [sesionCompletoId], references: [id])
  inicioAt          DateTime               @default(now())
  finAt             DateTime?
  estado            EstadoIntento          @default(EN_PROGRESO)
  respuestas        RespuestaReactivo[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model RespuestaReactivo {
  id                    Int            @id @default(autoincrement())
  intentoExamenId       Int
  intentoExamen         IntentoExamen  @relation(fields: [intentoExamenId], references: [id])
  reactivoId            Int
  reactivo              Reactivo       @relation(fields: [reactivoId], references: [id])
  respuestaSeleccionada String
  esCorrecta            Boolean?
  respondidoEnMs        Int
  createdAt             DateTime       @default(now())
}

/**
 * Ponderación de temas para el muestreo estratificado en armarExamen.
 * Un tema con peso alto aparece proporcionalmente más veces en el examen.
 * El campo `tema` coincide con Reactivo.tema (no es FK — coincidencia por convención).
 * Solo tiene efecto real en el examen de personalidad (único con muchos temas granulares
 * en un mismo bloque).
 */
model TemaPrioridad {
  tema             String   @id
  peso             Int      @default(1)
  descripcion      String?
  motivoContextual String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}