// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión DIRECTA a Postgres (sin pooler) para migraciones e introspección.
  // En producción DATABASE_URL apunta al POOLER (PgBouncer) y DIRECT_URL a la base
  // directa; el pooler no soporta las operaciones que hace `prisma migrate`.
  // En local ambas son la misma cadena.
  directUrl = env("DIRECT_URL")
}

model Plantel {
  id                Int                    @id @default(autoincrement())
  nombre            String
  descripcion       String?
  usuarios          Usuario[]
  examenes          Examen[]
  temarios          Temario[]
  sesionesCompletas SesionExamenCompleto[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Usuario {
  id                Int                    @id @default(autoincrement())
  nombre            String
  email             String                 @unique
  sesiones          Sesion[]
  password          String
  nivelAcceso       String                 @default("gratuito")
  /// Autorización dentro de la plataforma. "aspirante" (default) o "admin".
  /// El RolesGuard del backend lee este campo para gatear rutas del panel admin.
  rol               String                 @default("aspirante")
  emailVerificado   Boolean                @default(false)
  /// Estado de la cuenta, para el flujo "datos y luego pagar": ACTIVA (default) =
  /// cuenta normal; PENDIENTE = se creó al iniciar una compra pero el pago aún no
  /// se aprueba (no recibe acceso; un limpiador la borra si nunca paga). Las
  /// cuentas ya existentes quedan ACTIVA por el default: la migración no afecta a
  /// nadie que ya exista.
  estado            EstadoCuenta           @default(ACTIVA)
  plantelId         Int?
  plantel           Plantel?               @relation(fields: [plantelId], references: [id])
  sesionesCompletas SesionExamenCompleto[]
  intentos          IntentoExamen[]
  repasos           RepasoReactivo[]
  respuestasPractica RespuestaPractica[]
  actividadDiaria   ActividadDiaria[]
  seccionesLeidas   SeccionLeida[]
  accesos           Acceso[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

/// Acceso de un usuario a un módulo de pago, por convocatoria.
/// El candado del backend da acceso si existe una fila del módulo y `expiraEn`
/// no ha pasado. El "Pack Completa" crea dos filas (cultural + psicologico).
model Acceso {
  id         Int       @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])
  modulo     String // 'cultural' | 'psicologico'
  ciclo      String // convocatoria, p. ej. '2027'
  expiraEn   DateTime? // fin de la convocatoria; null = sin caducidad
  otorgadoEn DateTime  @default(now())
  origen     String    @default("manual") // 'manual' | 'mercadopago' | 'cortesia'

  @@unique([usuarioId, modulo, ciclo])
  @@index([usuarioId])
}

model Sesion {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
}

model Examen {
  id          Int             @id @default(autoincrement())
  tipo        String
  nombre      String
  duracionMin Int
  calificable Boolean         @default(true)
  // El examen cultural cambia por plantel y por año; el psicológico no.
  // Por eso los dos van opcionales: los exámenes psicológicos los dejan nulos.
  plantelId   Int?
  plantel     Plantel?        @relation(fields: [plantelId], references: [id])
  anio        Int?
  bloques     Bloque[]
  intentos    IntentoExamen[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Bloque {
  id           Int        @id @default(autoincrement())
  examenId     Int
  examen       Examen     @relation(fields: [examenId], references: [id])
  nombre       String
  orden        Int
  tiempoLimite Int
  reactivos    Reactivo[]
  createdAt    DateTime   @default(now())
}

model Reactivo {
  id                Int                 @id @default(autoincrement())
  // Un reactivo cuelga de UN Bloque (psicológico) O de UN Tema (cultural).
  // Los dos van opcionales: el reactivo cultural pertenece al libro/tema, no a
  // un examen fijo; el examen cultural se arma al vuelo eligiendo temas.
  bloqueId          Int?
  bloque            Bloque?             @relation(fields: [bloqueId], references: [id])
  temaId            Int?
  temaBanco         Tema?               @relation(fields: [temaId], references: [id])
  enunciado         String
  tipo              String              @default("opcion_multiple")
  opciones          Json
  respuestaCorrecta String?
  explicacion       String?
  // Cita bibliográfica con la página impresa, para que el aspirante pueda ir
  // al libro. Es regla dura del banco cultural.
  referencia        String?
  // Nota interna de quien revisa el banco. NUNCA se le muestra al aspirante:
  // nombra las opciones por su letra y el importador las baraja.
  notaRevisor       String?
  tema              String?
  polaridad         Polaridad?
  banco             String              @default("v1")
  eje               Int?
  subLote           Int?
  numeroEnEje       Int?
  parNumero         Int?
  tipoTrampa        TipoTrampa?
  esCritico         Boolean             @default(false)
  noPuntua          Boolean             @default(false)
  // Vínculo militar 🎖 del banco v3: metadato de diseño (el reactivo se ancla en
  // lo castrense). Va en columna, NO en el enunciado — el 🎖 jamás debe verlo el
  // aspirante. El importador lo setea y limpia el 🎖 del texto.
  militar           Boolean             @default(false)
  subnota           String?
  marco             String?
  crossRef          String?
  imagenUrl         String?
  respuestas        RespuestaReactivo[]
  repasos           RepasoReactivo[]
  respuestasPractica RespuestaPractica[]
  createdAt         DateTime            @default(now())
}

// --- Banco cultural: lado de la OFERTA (a qué pertenece un reactivo) ---
// El reactivo cultural pertenece al LIBRO, no al plantel. La jerarquía es
// Libro → Capítulo/Unidad → Tema → Reactivo. La DEMANDA (Plantel → Carrera →
// Temario por año → selecciona Temas) se modela aparte cuando se arme el examen.

model Libro {
  id              Int              @id @default(autoincrement())
  // IDENTIDAD del libro: un slug estable que controlamos, uno por libro real.
  // Sale de la carpeta-por-libro ("algebra-baldor", "fisica-perez-montiel"); para
  // HCM/EMM aún sin migrar se arma "<materia>-<apellido>" (p. ej. "espanol-zarzar").
  // El "código de materia" NO vive aquí: es de la DEMANDA y está en temarios.json,
  // donde un mismo libro lo citan varios códigos.
  slug            String           @unique
  materia         String // "Álgebra", "Física" — dato legible, no identidad
  autor           String // "Baldor, Aurelio" — se lee de la 1ª Referencia del reactivo
  edicion         String?
  anio            Int?
  isbn            String?
  capitulos       Capitulo[]
  materiasTemario MateriaTemario[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Capitulo {
  id                 Int                      @id @default(autoincrement())
  libroId            Int
  libro              Libro                    @relation(fields: [libroId], references: [id])
  numero             Int
  titulo             String
  temas              Tema[]
  seleccionesTemario MateriaTemarioCapitulo[]
  createdAt          DateTime                 @default(now())

  @@unique([libroId, numero])
}

model Tema {
  id         Int        @id @default(autoincrement())
  capituloId Int
  capitulo   Capitulo   @relation(fields: [capituloId], references: [id])
  // Texto de la línea `**Subtema:**` del reactivo, p. ej. "física · vectores".
  nombre     String
  reactivos  Reactivo[]
  createdAt  DateTime   @default(now())

  @@unique([capituloId, nombre])
}

// --- Banco cultural: lado de la DEMANDA (qué pide cada plantel cada año) ---
// Contraparte de la OFERTA de arriba. Reemplaza a docs/examen-cultural/temarios.json
// + puente-oferta-demanda.json, para poder editar el temario desde el panel admin y
// versionarlo por año. Un Temario es lo que un plantel pide en un año; cada
// MateriaTemario dice de qué libro sale, cuántas preguntas entran (el reparto) y
// —vía MateriaTemarioCapitulo— qué capítulos se llaman.

enum EstadoTemario {
  BORRADOR
  PUBLICADO
}

model Temario {
  id        Int              @id @default(autoincrement())
  plantelId Int
  plantel   Plantel          @relation(fields: [plantelId], references: [id])
  anio      Int
  estado    EstadoTemario    @default(BORRADOR)
  materias  MateriaTemario[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Un plantel tiene un temario por año y estado: deja convivir un borrador con
  // el publicado (se edita el borrador y luego se publica).
  @@unique([plantelId, anio, estado])
}

model MateriaTemario {
  id           Int                      @id @default(autoincrement())
  temarioId    Int
  temario      Temario                  @relation(fields: [temarioId], references: [id])
  nombre       String // "Matemáticas"
  libroId      Int
  libro        Libro                    @relation(fields: [libroId], references: [id])
  numPreguntas Int // el reparto: cuántas preguntas de esta materia entran al examen
  orden        Int
  capitulos    MateriaTemarioCapitulo[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model MateriaTemarioCapitulo {
  id               Int            @id @default(autoincrement())
  materiaTemarioId Int
  materiaTemario   MateriaTemario @relation(fields: [materiaTemarioId], references: [id])
  capituloId       Int
  capitulo         Capitulo       @relation(fields: [capituloId], references: [id])
  createdAt        DateTime       @default(now())

  // Para bajar a nivel tema en el futuro, aquí se agrega un temaId opcional.
  @@unique([materiaTemarioId, capituloId])
}

enum Polaridad {
  POSITIVA
  NEGATIVA
  TRAMPA
}

enum TipoTrampa {
  L
  K
  F
  CROSS
}

enum EstadoCuenta {
  PENDIENTE
  ACTIVA
}

enum EstadoSesion {
  EN_PROGRESO
  COMPLETADA
  ABANDONADA
}

enum EstadoIntento {
  EN_PROGRESO
  COMPLETADA
  TIEMPO_AGOTADO
  ABANDONADA
}

model SesionExamenCompleto {
  id        Int             @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])
  plantelId Int
  plantel   Plantel         @relation(fields: [plantelId], references: [id])
  inicioAt  DateTime        @default(now())
  finAt     DateTime?
  estado    EstadoSesion    @default(EN_PROGRESO)
  intentos  IntentoExamen[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model IntentoExamen {
  id               Int                   @id @default(autoincrement())
  usuarioId        Int
  usuario          Usuario               @relation(fields: [usuarioId], references: [id])
  examenId         Int
  examen           Examen                @relation(fields: [examenId], references: [id])
  sesionCompletoId Int?
  sesionCompleto   SesionExamenCompleto? @relation(fields: [sesionCompletoId], references: [id])
  inicioAt         DateTime              @default(now())
  finAt            DateTime?
  estado           EstadoIntento         @default(EN_PROGRESO)
  respuestas       RespuestaReactivo[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model RespuestaReactivo {
  id                    Int           @id @default(autoincrement())
  intentoExamenId       Int
  intentoExamen         IntentoExamen @relation(fields: [intentoExamenId], references: [id])
  reactivoId            Int
  reactivo              Reactivo      @relation(fields: [reactivoId], references: [id])
  respuestaSeleccionada String
  esCorrecta            Boolean?
  respondidoEnMs        Int
  createdAt             DateTime      @default(now())
}

/**
 * Memoria de repaso espaciado — la "capa verde".
 * RespuestaReactivo guarda cada respuesta suelta de un intento. Esto es distinto:
 * recuerda el ESTADO de un dato a lo largo del tiempo para UN aspirante. Una fila
 * por par (usuario, reactivo).
 * Usa cajas de Leitner: `caja` 1..5 y `proximoRepaso` crece con la caja. Acierta →
 * sube de caja (vuelve más tarde). Falla → cae a la caja 1 (vuelve mañana). La cola
 * del día son las filas del usuario con `proximoRepaso` ya vencido.
 * Se siembra sola al terminar un simulacro cultural (ver módulo `repasos`).
 */
model RepasoReactivo {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  reactivoId    Int
  reactivo      Reactivo @relation(fields: [reactivoId], references: [id])
  caja          Int      @default(1)
  rachaAciertos Int      @default(0)
  proximoRepaso DateTime
  ultimoVistoAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Un aspirante tiene un solo estado de repaso por reactivo.
  @@unique([usuarioId, reactivoId])
  // La cola del día pregunta por (usuario, proximoRepaso <= ahora): este índice la hace barata.
  @@index([usuarioId, proximoRepaso])
}

/**
 * Respuesta suelta de PRÁCTICA (Fase 04, sin cronómetro). A diferencia de
 * RespuestaReactivo —que cuelga de un IntentoExamen (simulacro)—, la práctica no
 * arma un intento: es estudio libre. Guardamos una fila por respuesta para tres
 * cosas: saber que el aspirante "ya practicó" (onboarding), medir su dominio por
 * tema (progreso) y sus días activos (racha).
 */
model RespuestaPractica {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  reactivoId Int
  reactivo   Reactivo @relation(fields: [reactivoId], references: [id])
  esCorrecta Boolean
  createdAt  DateTime @default(now())

  @@index([usuarioId])
  @@index([usuarioId, createdAt])
}

/**
 * Un día en que el aspirante estuvo activo (contestó ≥1 reactivo en práctica,
 * simulacro o repaso). Alimenta la racha de días del panel. `fecha` es la fecha
 * LOCAL de México ("AAAA-MM-DD"), para que la racha no se rompa a medianoche por
 * UTC. Una fila por (usuario, día); el upsert la deja idempotente.
 */
model ActividadDiaria {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  fecha     String   // "AAAA-MM-DD" en hora de México
  createdAt DateTime @default(now())

  @@unique([usuarioId, fecha])
  @@index([usuarioId])
}

/**
 * Una sección de la Guía del Aspirante que el usuario ya leyó.
 *
 * `slug` es texto y NO una llave foránea a propósito: las secciones de la Guía
 * no viven en la base, son archivos .md en docs/guia-aspirante/, y el slug (el
 * nombre del archivo sin extensión) es su identificador canónico. El índice
 * `SECCIONES_ONLINE` del frontend es la fuente de verdad del catálogo.
 *
 * El @@unique de usuario+slug hace que marcar dos veces no duplique: el
 * servicio usa upsert y se puede llamar sin miedo cada vez que se abre una
 * sección.
 *
 * Se marca al ENTRAR a la sección, no al terminarla. Es una decisión de
 * producto: desde el panel de resultados el aspirante entra a buscar un dato
 * suelto y se sale sin bajar; medir el final dejaría la barra en cero para el
 * uso más común. Por eso también hay forma de reiniciar el avance.
 */
model SeccionLeida {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  slug      String
  createdAt DateTime @default(now())

  @@unique([usuarioId, slug])
  @@index([usuarioId])
}

/**
 * Ponderación de temas para el muestreo estratificado en armarExamen.
 * Un tema con peso alto aparece proporcionalmente más veces en el examen.
 * El campo `tema` coincide con Reactivo.tema (no es FK — coincidencia por convención).
 * Solo tiene efecto real en el examen de personalidad (único con muchos temas granulares
 * en un mismo bloque).
 */
model TemaPrioridad {
  tema             String   @id
  peso             Int      @default(1)
  descripcion      String?
  motivoContextual String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
