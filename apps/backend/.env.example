# Plantilla de variables de entorno del backend.
# Copia este archivo a `.env` y rellena los valores reales.
# El `.env` real NUNCA se sube a git (está en .gitignore).

# Conexión a la base de datos PostgreSQL.
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/basededatos"

# Secreto para firmar los tokens de sesión (JWT).
# Usa una cadena larga y aleatoria (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="pon-aqui-una-cadena-larga-y-aleatoria"

# Puerto del backend (el frontend Next.js usa el 3000).
PORT=3001

# Páginas web autorizadas a hablarle al backend (CORS).
# Una o varias, separadas por coma. En producción, el dominio real.
# Si se omite, cae a http://localhost:3000 (desarrollo).
CORS_ORIGIN="http://localhost:3000"

# Cloudinary — imágenes de reactivos (bloque 5, razonamiento abstracto).
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
