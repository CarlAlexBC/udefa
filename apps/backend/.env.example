# Plantilla de variables de entorno del backend.
# Copia este archivo a `.env` y rellena los valores reales.
# El `.env` real NUNCA se sube a git (está en .gitignore).

# Conexión a la base de datos PostgreSQL.
# En producción, DATABASE_URL apunta al POOLER (PgBouncer), p. ej. el de Neon/Supabase.
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/basededatos"

# Conexión DIRECTA a la base (sin pooler), sólo para migraciones/introspección de Prisma.
# En local es la MISMA cadena que DATABASE_URL; en producción, la cadena directa del proveedor.
DIRECT_URL="postgresql://usuario:contraseña@host:puerto/basededatos"

# Secreto para firmar los tokens de sesión (JWT).
# Usa una cadena larga y aleatoria (mínimo 32 caracteres). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="pon-aqui-una-cadena-larga-y-aleatoria"

# Puerto del backend (el frontend Next.js usa el 3000).
PORT=3001

# Páginas web autorizadas a hablarle al backend (CORS).
# Una o varias, separadas por coma. En producción, el dominio real.
# Si se omite, cae a http://localhost:3000 (desarrollo).
CORS_ORIGIN="http://localhost:3000"

# Candado de acceso (muro de pago). 'on' = exige acceso comprado para los
# módulos de pago (cultural / psicológico). Cualquier otro valor (o ausente) =
# APAGADO: todo abierto, como antes de cobrar. Enciéndelo al lanzar con pago.
CANDADO_ACCESO="off"

# Mercado Pago — Checkout Pro. El Access Token es SECRETO: va solo aquí, nunca
# en el frontend ni en git. Empieza con las credenciales de PRUEBA (sandbox);
# cuando todo funcione, se cambia por las de producción.
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx-...-tu-access-token-de-prueba"
# URL pública del backend para que Mercado Pago avise los pagos (webhook).
# En local hará falta un túnel (ngrok); en producción, tu dominio del backend.
MERCADOPAGO_WEBHOOK_URL="https://tu-backend-publico.com/pagos/webhook"
# Secreto con el que Mercado Pago FIRMA cada aviso del webhook, para comprobar
# que el aviso viene de MP y no de un impostor. Se copia del panel de MP:
# "Tus integraciones" → tu aplicación → Webhooks → "Clave secreta".
# Si se deja vacío, el webhook procesa los avisos igual pero deja una ADVERTENCIA
# en el log en cada llamada. En producción debe estar puesto.
MERCADOPAGO_WEBHOOK_SECRET=""
# A dónde vuelve el aspirante tras pagar (tu frontend). Default localhost:3000.
FRONTEND_URL="http://localhost:3000"

# Resend — correos transaccionales (recibo, "acceso listo", recuperar contraseña).
# Si se OMITE, el backend entra en MODO CONSOLA: no manda, solo escribe el correo
# en la consola (útil para desarrollo). La llave empieza con "re_"; créala en resend.com.
RESEND_API_KEY=""
# Remitente de los correos. En pruebas (sin dominio verificado) Resend solo permite
# "onboarding@resend.dev" y solo envía a tu propio correo. Con dominio propio:
# "El Monote te Guía <no-reply@tudominio.com>".
MAIL_FROM="El Monote te Guía <onboarding@resend.dev>"

# Cloudinary — imágenes de reactivos (bloque 5, razonamiento abstracto).
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
